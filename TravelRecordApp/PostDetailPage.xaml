<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TravelRecordApp.PostDetailPage"
             xmlns:vm="clr-namespace:TravelRecordApp.ViewModel">
    <ContentPage.Resources>

        <ResourceDictionary>
            <vm:TravelDetailsVM x:Key="vm"/>




        </ResourceDictionary>
    </ContentPage.Resources>
    <StackLayout>
        <Entry x:Name="experienceEntry"/>
        <Button x:Name="updateButton" Text="Update" Command="{Binding Source={StaticResource vm},Path=UpdateCommand}" CommandParameter="{Binding Source={x:Reference experienceEntry},Path=Text}"/>
        <Button x:Name="deleteButton" Text="Delete" Command="{Binding Source={StaticResource vm},Path=DeleteCommand}"/>
    </StackLayout>
</ContentPage>
    


