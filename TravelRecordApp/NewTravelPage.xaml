<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TravelRecordApp.ViewModel"
             x:Class="TravelRecordApp.NewTravelPage">

    <ContentPage.Resources>
        <ResourceDictionary>
            <vm:NewTravelVM x:Key="vm"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Save" BindingContext="{StaticResource vm}" IconImageSource="save.png" Command="{Binding SaveCommand}" CommandParameter="{Binding PostIsReady}"/>
    </ContentPage.ToolbarItems>
    
    
    <ContentPage.Content>
        <StackLayout BindingContext="{StaticResource vm}">
            <Entry x:Name="experienceEntry" Text="{Binding Experience}" Placeholder="Enter your Experience"/>
            <ListView x:Name="venueListView" SelectedItem="{Binding SelectedVenue}"  ItemsSource="{Binding Venues}" Margin="20, 0" HorizontalOptions="FillAndExpand">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>

                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>

                                </Grid.RowDefinitions>


                                <Label Text="{Binding name}" FontAttributes="Bold"/>
                                <Label Grid.Row="1" Text="{Binding location.address}" TextColor="DodgerBlue"/>
                                <Label Grid.Column="1" Text="{Binding location.postcode,StringFormat='{0}'}"/>
                            </Grid>
                        </ViewCell>
                    </DataTemplate>
                    
                    
                </ListView.ItemTemplate>
                
                
                
                
            </ListView>
        </StackLayout>
        
    </ContentPage.Content>
</ContentPage>