<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TravelRecordApp.ProfilePage"
             xmlns:vm="clr-namespace:TravelRecordApp.ViewModel">


    <ContentPage.Resources>


        <ResourceDictionary>
            <vm:ProfileVM x:Key="vm"></vm:ProfileVM>
            
            
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.Content>
        <StackLayout Margin="20,40,20,0" BindingContext="{StaticResource vm}">
            <Label x:Name="postCountLabel" HorizontalOptions="Center" TextColor="DodgerBlue" Text="{Binding PostCount}" FontAttributes="Bold"
                 />
            <Label Text="posts" HorizontalOptions="Center" TextColor="LightGray"/>
            <ListView x:Name="categoriesListView" ItemsSource="{Binding Categories}">
                <ListView.ItemTemplate>
                    <DataTemplate>

                        <TextCell Text="{Binding Path=Name}" Detail="{Binding Path=Count}"/>
                    </DataTemplate>
                    
                </ListView.ItemTemplate>
                
            </ListView>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>